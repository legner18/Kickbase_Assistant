DB_USER=kickbase
DB_PASSWORD=change-me

KICKBASE_EMAIL=your-email@example.com
KICKBASE_PASSWORD=your-kickbase-password

# Unguessable topic name for ntfy.sh push notifications (Aufstellungs-Wächter).
# Anyone who knows this topic can read/publish to it on the public ntfy.sh instance -
# generate a random one, e.g. `openssl rand -hex 16`.
NTFY_TOPIC=your-random-ntfy-topic

FRONTEND_ORIGIN=http://localhost:4200
ASPNETCORE_ENVIRONMENT=Production
