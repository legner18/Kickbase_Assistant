DB_USER=kickbase
DB_PASSWORD=change-me

KICKBASE_EMAIL=your-email@example.com
KICKBASE_PASSWORD=your-kickbase-password

# Unguessable topic name for ntfy.sh push notifications (Aufstellungs-Wächter).
# Anyone who knows this topic can read/publish to it on the public ntfy.sh instance -
# generate a random one, e.g. `openssl rand -hex 16`.
NTFY_TOPIC=your-random-ntfy-topic

# Optional: Key von https://the-odds-api.com (kostenlos, 500 Abrufe/Monat) für die Wettquoten.
# Leer lassen, dann bleibt der Quoten-Job aus.
ODDS_API_KEY=

# Gemeinsames Secret von Api und Worker: nur wer es kennt, darf Live-Updates über den SignalR-Hub
# an alle Browser schicken. Zufällig erzeugen, z.B. `openssl rand -hex 32`.
LIVE_HUB_PUBLISH_KEY=your-random-live-hub-key

FRONTEND_ORIGIN=http://localhost:4200
ASPNETCORE_ENVIRONMENT=Production
